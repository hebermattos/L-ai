# Copy this file to .env and generate a unique secret with: openssl rand -hex 32
# Never commit real credentials.
WEBUI_SECRET_KEY=replace-me-with-a-random-secret

# Any installed/pullable Ollama model. Defaults preserve existing installations.
L_AI_MODEL=qwen3:4b-instruct
L_AI_CONTEXT_LENGTH=8192

# Tune these values for the available RAM/VRAM and expected workload.
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
